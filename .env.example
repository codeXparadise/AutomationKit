# n8n Security & Encryption
N8N_ENCRYPTION_KEY=change_this_to_a_strong_secret
N8N_RUNNERS_AUTH_TOKEN=change_this_to_a_strong_runner_token

# PostgreSQL Credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=automation

# Redis Security
REDIS_PASSWORD=change_this_password

# SearXNG
SEARXNG_BASE_URL=http://search.local

# Qdrant
QDRANT_API_KEY=admin:change_this_password

# Neo4j uses its built-in `neo4j` admin user.
NEO4J_PASSWORD=change_this_password

# IBM Docling & Crawl4AI
DOCLING_API_KEY=change_this_docling_key
CRAWL4AI_API_TOKEN=change_this_crawl4ai_token
CRAWL4AI_API_KEY=change_this_crawl4ai_token

# n8n Assistant Sandbox Configuration
N8N_SANDBOX_VERSION=1.9.0
SANDBOX_API_KEYS=change_this_sandbox_api_key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change_this_registration_token
SANDBOX_API_RUNNER_API_KEY=change_this_runner_key
N8N_SANDBOX_SERVICE_API_KEY=change_this_sandbox_api_key

# Supabase Local Self-Hosted Suite
