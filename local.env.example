# Copy this file to local.env and adjust the values before starting the stack.
# Example shell usage:
#   cp local.env.example local.env
#   source ./local.env
#   docker compose up -d

export N8N_ENCRYPTION_KEY="change_this_to_a_strong_secret"
export N8N_RUNNERS_AUTH_TOKEN="change_this_to_a_strong_runner_token"

export POSTGRES_USER="admin"
export POSTGRES_PASSWORD="change_this_password"
export POSTGRES_DB="automation"

export REDIS_PASSWORD="change_this_password"

export SEARXNG_BASE_URL="http://searxng.localhost"
export QDRANT_API_KEY="admin:change_this_password"
export NEO4J_USER="admin"
export NEO4J_PASSWORD="change_this_password"
